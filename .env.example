# Choose: openai, openrouter, or gemini
MODEL_PROVIDER=gemini

# Set this to a model ID available to your provider
MODEL_ID=gemini-3.6-flash
# openrouter/free
# gemini-3.1-flash-lite
# gemini-3.6-flash
# gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

MAX_AGENT_ITERATIONS=30
MAX_REVIEW_FIX_CYCLES=3
COMMAND_TIMEOUT_SECONDS=600
REQUIRE_APPROVAL_FOR_COMMANDS=true
REQUIRE_APPROVAL_FOR_FILE_CHANGES=true

REVIEW_FIX_MIN_SEVERITY=high

# always is the default; auto follows the terminal; never disables colors
CODEAMIL_COLOR=always

# always is the default; auto follows the terminal; never disables animation
CODEAMIL_ANIMATION=always
